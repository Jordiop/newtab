{
    "manifest_version": 3,
    "name": "NewTab Pro",
    "version": "1.1.0",
    "description": "A beautiful and modern new tab page with productivity features and custom wallpapers",
    "permissions": [
      "storage"
    ],
    "optional_permissions": [
      "bookmarks"
    ],
    "chrome_url_overrides": {
      "newtab": "newtab.html"
    },
    "icons": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg", 
      "48": "icons/icon.svg",
      "128": "icons/icon.svg"
    },
    "action": {
      "default_title": "NewTab Pro Settings"
    }
  }